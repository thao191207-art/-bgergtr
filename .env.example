# ==============================================================================
# SAOVIET CRM - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Hãy sao chép tệp này thành .env hoặc .env.local và điền giá trị thực tế của bạn.
# Xem hướng dẫn chi tiết tại: docs/huong-dan-cai-dat.md
# ==============================================================================

# 1. TÊN VÀ ĐỊA CHỈ ỨNG DỤNG
APP_NAME="SaoViet CRM - Hệ Thống Điều Hành Doanh Nghiệp"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (Supabase hoặc Neon)
# Bắt buộc: DATABASE_URL là đường dẫn kết nối Transaction Pooled (cổng 6543 đối với Supabase hoặc pooled endpoint đối với Neon)
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Bắt buộc: DIRECT_URL là đường dẫn kết nối trực tiếp (Direct Connection) dùng để chạy migration / schema push
DIRECT_URL="postgresql://postgres:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 3. XÁC THỰC & BẢO MẬT (NextAuth / Auth.js)
# Sinh chuỗi bí mật ngẫu nhiên: chạy lệnh `openssl rand -base64 32` hoặc vào trang https://generate-secret.vercel.app/32
AUTH_SECRET="chuoi-bi-mat-ngau-nhien-it-nhat-32-ky-tu"
NEXTAUTH_URL="http://localhost:3000"

# 4. BẢO VỆ TÁC VỤ ĐỊNH KỲ (Vercel Cron Jobs)
# Khóa bí mật dùng để xác thực request từ Vercel Cron đến các endpoint /api/cron/*
CRON_SECRET="khoa-bi-mat-cron-ngau-nhien-123456"

# 5. GỬI EMAIL THÔNG BÁO (Resend)
# Đăng ký miễn phí tại https://resend.com để lấy API key (gửi 3000 mail/tháng miễn phí)
RESEND_API_KEY="re_123456789abcdef"
EMAIL_FROM="SaoViet CRM <notifications@yourdomain.com>"

# 6. LƯU TRỮ TỆP ĐÍNH KÈM & ẢNH (Supabase Storage hoặc Vercel Blob)
# Lấy từ Project Settings -> API của dự án Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="saoviet-crm-attachments"

# 7. TÍCH HỢP TÙY CHỌN (Không bắt buộc)
# Khóa Gemini AI phục vụ phân tích tự động
GEMINI_API_KEY=""

# Tích hợp Zalo ZNS / Facebook Webhook (tùy chọn)
ZALO_APP_ID=""
ZALO_SECRET_KEY=""
FACEBOOK_APP_SECRET=""
